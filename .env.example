# Copy to .env.local for local overrides (never commit secrets).

# --- Meilisearch (optional) ---
# When set, search prefers Meili candidates then ranks in-process.
# If unset or Meili is down, fuse.js fallback is used automatically.
MEILI_HOST=http://127.0.0.1:7700
# MEILI_API_KEY=

# --- Open substances / 原料药 (UNII / NDC-derived) ---
# Default LIMIT raised to 8000 for local full-ish imports; git seed is smaller high-value set.
# OPEN_IMPORT_LIMIT=8000
# OPEN_IMPORT_REQUIRE_CAS=0
# OPEN_IMPORT_URL=
# OPEN_IMPORT_STREAM=1
# OPEN_IMPORT_CHUNK=5000

# --- Finished drugs / 成药 (openFDA NDC) ---
# OPEN_DRUG_IMPORT_LIMIT=4000
# OPEN_DRUG_IMPORT_URL=https://download.open.fda.gov/drug/ndc/drug-ndc-0001-of-0001.json.zip
# OPEN_DRUG_SKIP_DOWNLOAD=1
# OPEN_DRUG_FORCE_DOWNLOAD=0
# OPEN_DRUG_IMPORT_FILE=
